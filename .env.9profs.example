# 9Profs Core local development
NINEPROFS_CORE_ADDR=127.0.0.1:39761
NINEPROFS_CORE_DATA_DIR=data/9profs-core

# Docs uses NINEPROFS_CORE_ADDR when NINEPROFS_CORE_URL is unset.
# Set both to the same address only when using a non-default local or external Core.
# NINEPROFS_CORE_URL=http://127.0.0.1:39761

# Semantic Research model configuration.
# Supported providers are openai and anthropic. Use provider=openai with a custom
# BASE_URL for OpenAI-compatible or local model servers. The API key environment
# variable names are separate per task even when all tasks use one credential.
OPENAI_API_KEY=

NINEPROFS_CLAIM_EXTRACTOR_PROVIDER=openai
NINEPROFS_CLAIM_EXTRACTOR_MODEL=gpt-4o-mini
NINEPROFS_CLAIM_EXTRACTOR_BASE_URL=https://api.openai.com/v1
NINEPROFS_CLAIM_EXTRACTOR_API_KEY_ENV=OPENAI_API_KEY

NINEPROFS_CITATION_ASSESSOR_PROVIDER=openai
NINEPROFS_CITATION_ASSESSOR_MODEL=gpt-4o-mini
NINEPROFS_CITATION_ASSESSOR_BASE_URL=https://api.openai.com/v1
NINEPROFS_CITATION_ASSESSOR_API_KEY_ENV=OPENAI_API_KEY
NINEPROFS_CITATION_ASSESSOR_TIMEOUT_MS=120000

NINEPROFS_CITATION_EXPECTATION_ASSESSOR_PROVIDER=openai
NINEPROFS_CITATION_EXPECTATION_ASSESSOR_MODEL=gpt-4o-mini
NINEPROFS_CITATION_EXPECTATION_ASSESSOR_BASE_URL=https://api.openai.com/v1
NINEPROFS_CITATION_EXPECTATION_ASSESSOR_API_KEY_ENV=OPENAI_API_KEY
NINEPROFS_CITATION_EXPECTATION_ASSESSOR_TIMEOUT_MS=120000

NINEPROFS_CROSS_CLAIM_CANDIDATE_PROVIDER=openai
NINEPROFS_CROSS_CLAIM_CANDIDATE_MODEL=gpt-4o-mini
NINEPROFS_CROSS_CLAIM_CANDIDATE_BASE_URL=https://api.openai.com/v1
NINEPROFS_CROSS_CLAIM_CANDIDATE_API_KEY_ENV=OPENAI_API_KEY
NINEPROFS_CROSS_CLAIM_CANDIDATE_TIMEOUT_MS=120000

NINEPROFS_CROSS_CLAIM_CONSISTENCY_ASSESSOR_PROVIDER=openai
NINEPROFS_CROSS_CLAIM_CONSISTENCY_ASSESSOR_MODEL=gpt-4o-mini
NINEPROFS_CROSS_CLAIM_CONSISTENCY_ASSESSOR_BASE_URL=https://api.openai.com/v1
NINEPROFS_CROSS_CLAIM_CONSISTENCY_ASSESSOR_API_KEY_ENV=OPENAI_API_KEY
NINEPROFS_CROSS_CLAIM_CONSISTENCY_ASSESSOR_TIMEOUT_MS=120000

# Dify retrieval for citation evidence verification. Leave API key empty for
# semantic Research review without Dify. Configure both values for full citation
# evidence verification; Dify's API base URL normally ends in /v1.
NINEPROFS_DIFY_BASE_URL=
NINEPROFS_DIFY_API_KEY=
NINEPROFS_DIFY_TIMEOUT_MS=30000
NINEPROFS_DIFY_INDEXING_TECHNIQUE=high_quality
