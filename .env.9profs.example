# 9Profs Core
NINEPROFS_CORE_ADDR=127.0.0.1:39761
NINEPROFS_CORE_DATA_DIR=data/9profs-core

# Default semantic model
OPENAI_API_KEY=

NINEPROFS_MODEL_PROVIDER=openai
NINEPROFS_MODEL_MODEL=gpt-5.6-luna
NINEPROFS_MODEL_BASE_URL=https://api.openai.com/v1
NINEPROFS_MODEL_API_KEY_ENV=OPENAI_API_KEY
NINEPROFS_MODEL_TIMEOUT_MS=120000

# Dify
NINEPROFS_DIFY_BASE_URL=
NINEPROFS_DIFY_API_KEY=
NINEPROFS_DIFY_TIMEOUT_MS=30000
NINEPROFS_DIFY_INDEXING_TECHNIQUE=high_quality
